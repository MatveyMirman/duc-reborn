# DUC Reborn - Environment Variables

# Admin credentials (required for first run)
# The app panics on first run if DUC_ADMIN_PASSWORD is not set.
DUC_ADMIN_USERNAME=admin
DUC_ADMIN_PASSWORD=your-password

# Require authentication for protected API routes (default: true)
# Set to false to disable auth (e.g. for trusted local networks).
DUC_REQUIRE_AUTH=true

# Session expiry in hours (default: 24)
DUC_SESSION_EXPIRY_HOURS=24

# Database path (default: ./duc.db for local dev, /data/duc.db for Docker)
DUC_DB_PATH=./duc.db

# CORS allowed origins (comma-separated)
# Set to specific origins when using auth (cookies). Use * only if DUC_REQUIRE_AUTH=false.
# For local dev with frontend on port 5173: http://localhost:5173
DUC_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
